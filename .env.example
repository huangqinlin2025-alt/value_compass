# 复制为 .env 后按需填写；.env 不得提交到仓库。
# 所有密钥只通过环境变量注入，禁止写入代码。

# ---------- Provider 选择 ----------
# hashing（零依赖）| bge（需 sentence-transformers）| openai_compat
# auto（默认）：装了 sentence-transformers 就自动用 bge，否则回落 hashing
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HASHING_DIM=384
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=mps        # 留空自动选：mps > cpu
# VC_MODEL_CACHE=./index/models  # 模型缓存目录；HF 拉不到时自动回落 ModelScope

# mock（默认，抽取式）| fake（契约测试用）| openai_compat
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# DeepSeek / 通义 / 智谱 / OpenAI 均为 OpenAI 兼容协议，换 base_url 与 model 即可
OPENAI_API_KEY=
# 结构化输出（JSON 契约）：json_object | off；校验失败是否自动修复重试一次
LLM_JSON_MODE=json_object
LLM_JSON_REPAIR=1
# 三个节点的 LLM 增强开关（关掉则纯规则/正则，链路照跑）
ROUTER_LLM_ENABLED=1
GATE_LLM_ENABLED=1
GENERATOR_JSON_ENABLED=1

# chroma（默认）| pickle（降级）
VECTOR_STORE_PROVIDER=chroma
# heuristic（默认，零依赖）| bge（需 sentence-transformers，bge-reranker-base）| none
RERANK_PROVIDER=heuristic
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- 路径 ----------
# VC_DATA_DIR=./data
# VC_INDEX_DIR=./index
# VC_DEFAULT_PDF=./data/sample_report.pdf

# ---------- 阈值与超时 ----------
# 相关性闸门：调高 -> 语料外问题更诚实，但会误杀合法问题（权衡表见 docs/dev/tuning.md）
# MIN_TOP1_RELEVANCE=0.28
# LOW_SCORE_MIN=0.008
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TIMEOUT_VECTOR=3.0
# TIMEOUT_RERANK=3.0
# TIMEOUT_LLM=30.0

# ---------- 服务 ----------
# 为空则关闭 /ingest 接口；设置后请求需带 X-Token 头
VC_INGEST_TOKEN=
VC_API_HOST=127.0.0.1
VC_API_PORT=8000
